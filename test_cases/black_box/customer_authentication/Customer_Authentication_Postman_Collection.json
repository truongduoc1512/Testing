      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const targetUrl = (pm.environment.get('base_url') || pm.collectionVariables.get('base_url') || 'http://localhost') + '/admin/login';",
              "pm.sendRequest({ url: targetUrl, method: 'GET' }, function (err, res) {",
              "    if (!err && res.text()) {",
              "        const match = res.text().match(/name=\"_csrf\"\\s+value=\"([^\"]+)\"/);",
              "        const csrfToken = (match && match[1]) ? match[1] : '';",
              "        const loginUrl = (pm.environment.get('base_url') || pm.collectionVariables.get('base_url') || 'http://localhost') + '/j_spring_security_check';",
              "        const regUser = pm.environment.get('rnd_reg_user') || pm.collectionVariables.get('rnd_reg_user') || 'user_test';",
              "        pm.sendRequest({",
              "            url: loginUrl,",
              "            method: 'POST',",
              "            header: {",
              "                'Content-Type': 'application/x-www-form-urlencoded',",
              "                'X-CSRF-TOKEN': csrfToken",
              "            },",
              "            body: {",
              "                mode: 'urlencoded',",
              "                urlencoded: [",
              "                    { key: 'userName', value: regUser },",
              "                    { key: 'password', value: 'SecurePass123!' },",
              "                    { key: '_csrf', value: csrfToken }",
              "                ]",
              "            }",
              "        }, function (loginErr, loginRes) {",
              "            // Logged in",
              "        });",
              "    }",
              "});"
            ]
          }
        },
