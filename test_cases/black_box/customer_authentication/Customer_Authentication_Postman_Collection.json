  "item": [
    {
      "name": "TC_AUTH_01 - [EP-V1,V2,V3,V4][DT-D4][ST-1] Đăng nhập User hợp lệ với tài khoản tồn tại",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const targetUrl = (pm.environment.get('base_url') || pm.collectionVariables.get('base_url') || 'http://localhost') + '/admin/login';",
              "pm.sendRequest({ url: targetUrl, method: 'GET' }, function (err, res) {",
              "    if (!err && res.text()) {",
              "        const match = res.text().match(/name=\"_csrf\"\\s+value=\"([^\"]+)\"/);",
              "        if (match && match[1]) {",
              "            pm.environment.set('csrf_token', match[1]);",
              "            pm.collectionVariables.set('csrf_token', match[1]);",
              "        }",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK or 302 Redirect', function () { pm.expect(pm.response.code).to.be.oneOf([200, 302]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/j_spring_security_check",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "j_spring_security_check"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "userName",
              "value": "{{customer_user}}"
            },
            {
              "key": "password",
              "value": "{{customer_pass}}"
            },
            {
              "key": "_csrf",
              "value": "{{csrf_token}}"
            }
          ]
        }
      }
    },
