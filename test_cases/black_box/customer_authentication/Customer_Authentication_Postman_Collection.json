      "name": "TC_AUTH_08 - [EP-V6,V7,V8][BVA-B1] Đăng ký tài khoản mới thành công (Dữ liệu danh định nom)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rnd = Math.floor(1000 + Math.random() * 9000);",
              "const u = 'u_nom_' + rnd;",
              "const e = 'u_nom_' + rnd + '@example.com';",
              "pm.environment.set('rnd_reg_user', u);",
              "pm.collectionVariables.set('rnd_reg_user', u);",
              "pm.environment.set('rnd_reg_email', e);",
              "pm.collectionVariables.set('rnd_reg_email', e);",
              "pm.environment.set('rnd_reg_pass', 'SecurePass123!');",
              "pm.collectionVariables.set('rnd_reg_pass', 'SecurePass123!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration succeeded (200 OK or 201 Created)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
            ]
          }
        }
