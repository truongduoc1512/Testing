            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Verify list filtered by brand and category', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.list).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ]
