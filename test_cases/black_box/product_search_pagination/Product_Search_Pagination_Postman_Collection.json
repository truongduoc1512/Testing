{
  "info": {
    "_postman_id": "product-search-pagination-full-collection-id",
    "name": "Product Search & Pagination Postman Collection",
    "description": "Bộ sưu tập kiểm thử API Tự động (Black-Box Testing) cho Chức năng 2 - Tìm kiếm & Phân trang Sản phẩm (Product Search & Pagination) của Hệ thống ShoeShop.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Group 1: Search & Filtering (Nhóm 1 - Tìm kiếm & Lọc sản phẩm)",
      "item": [
        {
          "name": "TC_SRCH_01 - Tìm kiếm với từ khóa hợp lệ",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products?name=Nike&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "name", "value": "Nike" },
                { "key": "page", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Verify totalRecords and currentPage', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalRecords');",
                  "    pm.expect(jsonData).to.have.property('currentPage', 1);",
                  "    pm.expect(jsonData.list).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_SRCH_02 - Tìm kiếm từ khóa không tồn tại",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products?name=XYZ_NOT_EXIST_123",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "name", "value": "XYZ_NOT_EXIST_123" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Verify totalRecords is 0 and list is empty', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalRecords).to.eql(0);",
                  "    pm.expect(jsonData.list).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_SRCH_03 - Tìm kiếm từ khóa SQL Injection",
