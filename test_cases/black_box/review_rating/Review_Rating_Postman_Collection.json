{
  "info": {
    "_postman_id": "review-rating-full-collection-id",
    "name": "Review & Rating Postman Collection",
    "description": "Bộ sưu tập kiểm thử API Tự động (Black-Box API Testing) cho Chức năng 6 - Đánh giá sản phẩm (Review & Rating) của Hệ thống ShoeShop.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Prerequisite: Authenticate User Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: pm.variables.get('base_url') + '/admin/login',",
              "    method: 'GET'",
              "}, function (err, res) {",
              "    if (!err && res.text()) {",
              "        const match = res.text().match(/name=\"_csrf\"\\s+value=\"([^\"]+)\"/);",
              "        if (match && match[1]) {",
              "            pm.variables.set('csrf_token', match[1]);",
              "        }",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authentication successful (Status 200/302)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "userName", "value": "employee1" },
            { "key": "password", "value": "123" },
            { "key": "_csrf", "value": "{{csrf_token}}" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/j_spring_security_check",
          "host": ["{{base_url}}"],
          "path": ["j_spring_security_check"]
        }
      }
    },
    {
      "name": "Group 1: Create Review (Nhóm 1 - Gửi bài đánh giá mới)",
      "item": [
