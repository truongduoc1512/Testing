          "path": ["api", "v1", "wishlist", "{{valid_product_code}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('State Transition back to UNFAVORITED (favorite: false)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.favorite).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC_WISH_04 - Xóa sản phẩm khỏi Wishlist qua API DELETE",
