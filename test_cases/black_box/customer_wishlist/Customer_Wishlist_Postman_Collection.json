{
  "info": {
    "_postman_id": "customer-wishlist-full-collection-id",
    "name": "Customer Wishlist Postman Collection",
    "description": "Bộ sưu tập kiểm thử API Tự động (Black-Box API Testing) cho Module B - Quản lý danh sách Yêu thích (Customer Wishlist) của Hệ thống ShoeShop.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" },
    { "key": "valid_product_code", "value": "S001", "type": "string" },
    { "key": "invalid_product_code", "value": "INVALID_CODE_99", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Prerequisite: Authenticate User Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: pm.variables.get('base_url') + '/admin/login',",
              "    method: 'GET'",
              "}, function (err, res) {",
              "    if (!err && res.text()) {",
              "        const match = res.text().match(/name=\"_csrf\"\\s+value=\"([^\"]+)\"/);",
              "        if (match && match[1]) {",
              "            pm.variables.set('csrf_token', match[1]);",
              "        }",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authentication successful (Status 200/302)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "userName", "value": "employee1" },
            { "key": "password", "value": "123" },
            { "key": "_csrf", "value": "{{csrf_token}}" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/j_spring_security_check",
          "host": ["{{base_url}}"],
          "path": ["j_spring_security_check"]
        }
      }
    },
    {
      "name": "Group 1: Wishlist Operations & State Transitions (Nhóm 1 - Thao tác Wishlist)",
      "item": [
        {
          "name": "TC_WISH_01 - Thêm sản phẩm vào Wishlist (State Transition S0 -> S1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.variables.get('base_url') + '/api/v1/wishlist/' + pm.variables.get('valid_product_code'),",
                  "    method: 'DELETE'",
                  "}, function (err, res) {",
                  "    // Ensured product is removed before adding",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('State Transition to FAVORITED (favorite: true)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.favorite).to.eql(true);",
                  "    pm.expect(jsonData.message).to.include('Đã thêm');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist/{{valid_product_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist", "{{valid_product_code}}"]
            }
          }
        },
        {
          "name": "TC_WISH_02 - Kiểm tra trạng thái sản phẩm trong Wishlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns favorite boolean status', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.favorite).to.be.a('boolean');",
                  "    pm.expect(jsonData.favorite).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist/check/{{valid_product_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist", "check", "{{valid_product_code}}"]
            }
          }
        },
        {
          "name": "TC_WISH_03 - Hủy yêu thích sản phẩm qua Toggle 1 chạm (State Transition S1 -> S0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('State Transition back to UNFAVORITED (favorite: false)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.favorite).to.eql(false);",
                  "    pm.expect(jsonData.message).to.include('Đã xóa');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist/{{valid_product_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist", "{{valid_product_code}}"]
            }
          }
        },
        {
          "name": "TC_WISH_04 - Xóa sản phẩm khỏi Wishlist qua API DELETE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Product removed from wishlist', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.favorite).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist/{{valid_product_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist", "{{valid_product_code}}"]
            }
          }
        },
        {
          "name": "TC_WISH_05 - Tải toàn bộ danh sách sản phẩm yêu thích",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns wishlist array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist"]
            }
          }
        },
        {
          "name": "TC_WISH_05B - Tải danh sách yêu thích khi chưa lưu sản phẩm nào",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.variables.get('base_url') + '/api/v1/wishlist/' + pm.variables.get('valid_product_code'),",
                  "    method: 'DELETE'",
                  "}, function (err, res) {",
                  "    // Ensure item is removed for empty list check",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns empty array []', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist"]
            }
          }
        },
        {
          "name": "TC_WISH_07 - Thao tác với sản phẩm không tồn tại / INACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist/{{invalid_product_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist", "{{invalid_product_code}}"]
            }
          }
        },
        {
          "name": "TC_WISH_06 - Chặn khách vãng lai (Guest) chưa đăng nhập",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jar = pm.cookies.jar();",
                  "jar.clear(pm.variables.get('base_url'), function (error) {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Cookie", "value": "JSESSIONID=EXPIRED_GUEST_SESSION" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wishlist",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "wishlist"]
            }
          }
        }
      ]
    }
  ]
}
