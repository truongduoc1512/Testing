# =================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Copy file này thành .env để tùy chỉnh biến môi trường cục bộ.
# File .env đã được cấu hình trong .gitignore để không bao giờ bị commit lên Git.
# =================================================================

# 1. PHIÊN BẢN ĐÓNG GÓI DOCKER RELEASE
APP_VERSION=v2.0.0

# 2. CẤU HÌNH DATABASE MYSQL (Docker Service Host: shoeshop-mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://shoeshop-mysql:3306/shoe_shopdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_root_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# 3. CẤU HÌNH DỊCH VỤ AI FASTAPI MICROSERVICE (Docker Service Host: ai-service)
AI_SERVICE_URL=http://ai-service:8000

# 4. CẤU HÌNH GOOGLE OAUTH2 LOGIN (Google Cloud Console)
# Truy cập https://console.cloud.google.com/apis/credentials để lấy keys
# Authorized Redirect URI: http://localhost/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
