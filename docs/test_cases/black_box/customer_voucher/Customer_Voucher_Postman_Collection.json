  "item": [
    {
      "name": "0. Setup - Authentication & Cart Session",
      "item": [
        {
          "name": "0.1 POST /j_spring_security_check - Customer Login (employee1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var baseUrl = pm.variables.get('base_url') || 'http://localhost';",
                  "pm.sendRequest({url: baseUrl + '/admin/login', method: 'GET'}, function (err, res) {",
                  "    if (!err && res.text()) {",
                  "        var m = res.text().match(/name=\"_csrf\"\\s+(?:value|content)=\"([^\"]+)\"/) || res.text().match(/content=\"([^\"]+)\"\\s+name=\"_csrf\"/);",
                  "        if (m) pm.environment.set('csrf_token', m[1]);",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SETUP] Đăng nhập Khách hàng employee1 thành công (HTTP 200/302)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "var sessionCookie = pm.cookies.get('JSESSIONID');",
                  "if (sessionCookie) pm.environment.set('user_session_id', sessionCookie);",
                  "var setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "    var m = String(setCookie).match(/JSESSIONID=([^;]+)/);",
                  "    if (m && m[1]) pm.environment.set('user_session_id', m[1]);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "userName",
                  "value": "{{user_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{user_password}}",
                  "type": "text"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrf_token}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/j_spring_security_check",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "j_spring_security_check"
              ]
            }
          }
        },
