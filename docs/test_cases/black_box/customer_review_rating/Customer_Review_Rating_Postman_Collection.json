{
  "info": {
    "_postman_id": "customer-review-rating-full-collection-id",
    "name": "Customer Review & Rating Postman Collection",
    "description": "Bộ sưu tập kiểm thử API Tự động (Black-Box API Testing) cho Module A - Đánh giá & Chấm sao sản phẩm (Customer Review & Rating) của Hệ thống ShoeShop.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" },
    { "key": "valid_product_code", "value": "S001", "type": "string" },
    { "key": "invalid_product_code", "value": "INVALID_CODE_99", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Prerequisite: Authenticate User Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: pm.variables.get('base_url') + '/admin/login',",
              "    method: 'GET'",
              "}, function (err, res) {",
              "    if (!err && res.text()) {",
              "        const match = res.text().match(/name=\"_csrf\"\\s+value=\"([^\"]+)\"/);",
              "        if (match && match[1]) {",
              "            pm.variables.set('csrf_token', match[1]);",
              "        }",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authentication successful (Status 200/302)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "userName", "value": "employee1" },
            { "key": "password", "value": "123" },
            { "key": "_csrf", "value": "{{csrf_token}}" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/j_spring_security_check",
          "host": ["{{base_url}}"],
          "path": ["j_spring_security_check"]
        }
      }
    },
    {
      "name": "Group 1: Create Review (Nhóm 1 - Gửi bài đánh giá mới)",
      "item": [
        {
          "name": "TC_REV_001 - Đánh giá 5 sao hợp lệ (BVA Max)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"S001\",\n  \"ratingValue\": 5,\n  \"comment\": \"Giày rất đẹp và đi êm chân\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 201 Created', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_REV_002 - Đánh giá 1 sao hợp lệ (BVA Min)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"S001\",\n  \"ratingValue\": 1,\n  \"comment\": \"Đế hơi cứng\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews",
              "host": ["{{base_url}}"],
