              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_REV_010 - Báo lỗi cấm sửa bài khi đã quá 5 phút",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Cố tình sửa sau 6 phút\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/{{expired_review_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews", "{{expired_review_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
