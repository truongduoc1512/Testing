            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"S001\",\n  \"ratingValue\": 0,\n  \"comment\": \"Sản phẩm quá kém\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_REV_005 - Chặn đánh giá 6 sao (BVA Max+1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"S001\",\n  \"ratingValue\": 6,\n  \"comment\": \"Tuyệt vời 6 sao\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_REV_006 - Báo lỗi 401 Khách vãng lai",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"S001\",\n  \"ratingValue\": 5,\n  \"comment\": \"Unauthenticated review attempt\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 2: Update Review (Nhóm 2 - Chỉnh sửa bài đánh giá)",
      "item": [
        {
          "name": "TC_REV_010B - Sửa thành công bài đánh giá chính chủ trong vòng 5 phút",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Cập nhật đánh giá sau 2 phút\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/{{created_review_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews", "{{created_review_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_REV_009 - Chặn sửa bài của người khác",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
