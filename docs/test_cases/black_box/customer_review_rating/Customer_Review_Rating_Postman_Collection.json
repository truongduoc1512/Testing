            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ratingValue\": 5,\n  \"comment\": \"Thử sửa bài của người khác\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/{{other_user_review_id}}",
              "host": ["{{base_url}}"],
