    },
    {
      "name": "Group 3: Delete Review (Nhóm 3 - Xóa bài đánh giá)",
      "item": [
        {
          "name": "TC_REV_011 - Xóa thành công bài đánh giá chính chủ",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
