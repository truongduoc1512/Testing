{
  "info": {
    "_postman_id": "group1-search-and-filtering-id",
    "name": "Group 1: Search & Filtering",
    "description": "JSON Collection riêng cho Nhóm 1: Tìm kiếm & Lọc sản phẩm",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" }
  ],
  "item": [
    {
      "name": "TC_SRCH_01 - Tìm kiếm với từ khóa hợp lệ",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?name=Nike&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "name", "value": "Nike" }, { "key": "page", "value": "1" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
            "pm.test('Returns valid pagination array', function () { var j = pm.response.json(); pm.expect(j.list).to.be.an('array'); });"
          ]
        }
      }]
    },
    {
      "name": "TC_SRCH_02 - Tìm kiếm từ khóa không tồn tại",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?name=XYZ_NOT_EXIST_123",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "name", "value": "XYZ_NOT_EXIST_123" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });",
            "pm.test('Returns totalRecords = 0 and empty list', function () { var j = pm.response.json(); pm.expect(j.totalRecords).to.eql(0); });"
          ]
        }
      }]
    },
    {
      "name": "TC_SRCH_03 - Tìm kiếm với từ khóa SQL Injection",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?name=%25%27OR%271%3D1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "name", "value": "%'OR'1=1" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });"
          ]
        }
      }]
    },
    {
      "name": "TC_SRCH_04 - Tìm kiếm với từ khóa rỗng",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?name=",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "name", "value": "" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });"
          ]
        }
      }]
    },
    {
      "name": "TC_SRCH_05 - Tìm kiếm không phân biệt hoa thường",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?name=nike",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "name", "value": "nike" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });"
          ]
        }
      }]
    },
    {
      "name": "TC_SRCH_06 - Kết hợp Tìm kiếm & Bộ lọc khoảng giá",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?name=Nike&minPrice=100&maxPrice=300",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "name", "value": "Nike" }, { "key": "minPrice", "value": "100" }, { "key": "maxPrice", "value": "300" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });"
          ]
        }
      }]
    },
    {
      "name": "TC_SRCH_07 - Lọc theo Thương hiệu & Danh mục",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/products?brand=Nike&category=Sneaker",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"],
          "query": [{ "key": "brand", "value": "Nike" }, { "key": "category", "value": "Sneaker" }]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP Status Code is 200 OK', function () { pm.response.to.have.status(200); });"
          ]
        }
      }]
    }
  ]
}
