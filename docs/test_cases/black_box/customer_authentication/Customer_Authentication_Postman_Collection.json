		{
			"name": "TC_AUTH_06 - [EP-V1][BVA-nom] Đăng ký tài khoản mới thành công (Dữ liệu chuẩn)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const rnd = Math.floor(1000 + Math.random() * 9000);",
							"pm.environment.set('rnd_reg_user', 'user_' + rnd);",
							"pm.environment.set('rnd_reg_email', 'user_' + rnd + '@example.com');"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Registration succeeded (200 OK or 201 Created)', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userName\": \"{{rnd_reg_user}}\",\n    \"email\": \"{{rnd_reg_email}}\",\n    \"password\": \"SecurePass123!\",\n    \"confirmPassword\": \"SecurePass123!\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/users/register",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "users", "register"]
				}
			}
		},
		{
			"name": "TC_AUTH_07 - [BVA-B0][min-] Đăng ký - Mật khẩu 5 ký tự (Dưới ngưỡng tối thiểu)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Rejected password shorter than min (400 Bad Request)', function () {",
							"    pm.response.to.have.status(400);",
