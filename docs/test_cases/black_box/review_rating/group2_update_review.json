{
  "info": {
    "_postman_id": "group2-update-review-id",
    "name": "Group 2: Update Review",
    "description": "JSON Collection riêng cho Nhóm 2: Chỉnh sửa bài đánh giá",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" },
    { "key": "review_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "TC_REV_009 - Chặn sửa Review của người khác",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Thử sửa bài người khác\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/reviews/9999",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "reviews", "9999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC_REV_010B - Sửa thành công bài đánh giá trong 5 phút",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Cập nhật đánh giá thành 4 sao\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/reviews/{{review_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "reviews", "{{review_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 200 OK or 400', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"
            ]
          }
        }
      ]
    }
  ]
}
