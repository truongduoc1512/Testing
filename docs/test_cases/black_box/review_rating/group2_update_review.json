{
  "info": {
    "name": "Group 2: Update Review (Nhóm 2 - Chỉnh sửa bài đánh giá)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC_REV_009 - Chặn sửa Review của người khác",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Hack review người khác\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/reviews/9999",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "reviews", "9999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC_REV_010 - Chặn sửa bài quá 5 phút",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Cập nhật quá 5 phút\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/reviews/100",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "reviews", "100"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC_REV_010B - Sửa thành công bài đánh giá chính chủ trong 5 phút",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ratingValue\": 4,\n  \"comment\": \"Cập nhật bài viết hợp lệ\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/reviews/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "reviews", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 200 OK or 400', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"
            ]
          }
        }
      ]
    }
  ]
}
