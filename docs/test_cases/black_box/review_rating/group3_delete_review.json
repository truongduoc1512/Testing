{
  "info": {
    "_postman_id": "group3-delete-review-id",
    "name": "Group 3: Delete Review",
    "description": "JSON Collection riêng cho Nhóm 3: Xóa bài đánh giá",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" },
    { "key": "review_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "TC_REV_011 - Xóa thành công Review chính chủ",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/reviews/{{review_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "reviews", "{{review_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP Status Code is 200 OK or 400', function () { pm.expect(pm.response.code).to.be.oneOf([200, 400]); });"
            ]
          }
        }
      ]
    }
  ]
}
